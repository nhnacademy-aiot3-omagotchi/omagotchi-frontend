# Frontend 실행 포트와 Session Cookie 설정
SERVER_PORT=8082
SESSION_COOKIE_NAME=OMAGOTCHI_SESSION

# Frontend를 local Profile로 실행할 때 Identity의 Frontend 호출 Credential과 같은 값을 사용한다.
FRONTEND_USERNAME=frontend
FRONTEND_PASSWORD=local-only-change-this-frontend-password

# 로컬 Redis와 Identity 연결에 필요한 설정
SESSION_REDIS_HOST=localhost
SESSION_REDIS_PORT=6379
SESSION_REDIS_USERNAME=
SESSION_REDIS_PASSWORD=
SESSION_REDIS_CONNECT_TIMEOUT=1s
SESSION_REDIS_COMMAND_TIMEOUT=2s
SESSION_REDIS_SSL_ENABLED=false
SESSION_REDIS_NAMESPACE=omagotchi:frontend:session
SESSION_TIMEOUT=PT30M
IDENTITY_SERVICE_BASE_URL=http://localhost:8083

# Frontend가 호출하는 모든 서비스 HTTP Client에 공통 적용.
HTTP_CLIENT_CONNECT_TIMEOUT=2s
HTTP_CLIENT_READ_TIMEOUT=5s
